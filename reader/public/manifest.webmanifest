{
  "name": "XFeed Paradise Reader",
  "short_name": "Paradise",
  "description": "Your private, pre-filtered X feed from the XFeed Paradise extension.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
